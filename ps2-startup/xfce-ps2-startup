#!/usr/bin/env bash
# ==============================================================================
# xfce-ps2-startup — PlayStation 2 Inspired XFCE Startup Video Suite
# Replaces / supplements desktop boot with a custom-engineered PS2 BIOS sequence:
# Monolithic crystal towers, atmospheric void, ethereal choir/chimes, and XFCE 4.20 reveal.
# ==============================================================================
set -euo pipefail

# Resolve canonical directory of this script, following symlinks if necessary
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
BASE_DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"

VIDEO_FILE="$BASE_DIR/ps2_xfce_startup.mp4"
HTML_INDEX="$BASE_DIR/index.html"
INPUT_CONF="$BASE_DIR/input.conf"
AUTOSTART_FILE="$HOME/.config/autostart/ps2-xfce-startup.desktop"
LOCK_FILE="/tmp/ps2_startup.lock"

# Help message
show_help() {
    cat << 'EOF'
======================================================================
  🎮 PlayStation 2 // XFCE 4.20 Startup Sequence Suite
======================================================================
Usage: ps2-startup [OPTIONS]

Options:
  --play                 (Default) Launch fullscreen PS2 animated startup via mpv
  --window               Launch in windowed preview mode (1280x720)
  --web                  Launch real-time interactive Three.js WebGL engine in Chromium
  --install-boot-sequence  PS2 animation + PS2 XFCE SDDM login theme it hands over to
  --remove-boot-sequence   Undo the above
  --install-system-boot  Set as system startup boot animation (SDDM Xsetup)
  --remove-system-boot   Remove system startup boot animation
  --install-greeter      Install only the PS2 XFCE SDDM login theme
  --remove-greeter       Restore the default SDDM theme
  --install-autostart    Register as XFCE user session startup (login)
  --remove-autostart     Disable XFCE user session startup
  --status               Show system boot & autostart status and video metadata
  --rebuild              Re-render and re-encode the MP4 animation from source
  -h, --help             Show this help message

Interactive Controls during playback:
  [ESC] / [Q] / [Click] Instantly skip startup animation to desktop
  [SPACE]               Pause / Resume animation
  [ENTER]               Skip to desktop
======================================================================
EOF
}

# Check single instance to prevent overlapping startup audio/video
check_lock() {
    exec 200>"$LOCK_FILE"
    if ! flock -n 200; then
        echo "[!] PS2 startup animation is already currently active."
        exit 0
    fi
}

play_video() {
    local fullscreen_flag="--fs"
    local geometry_flag=""
    local ontop_flag="--ontop"
    
    if [[ "${1:-}" == "--window" ]]; then
        fullscreen_flag="--no-fs"
        geometry_flag="--geometry=1280x720"
        ontop_flag="--no-ontop"
    fi

    if [[ ! -f "$VIDEO_FILE" ]]; then
        echo "[!] Video file not found: $VIDEO_FILE"
        echo "[*] Triggering automated build pipeline..."
        rebuild_video
    fi

    check_lock

    # Ensure display environment is present
    if [[ -z "${DISPLAY:-}" ]]; then
        export DISPLAY=:0.0
    fi

    local input_arg=()
    if [[ -f "$INPUT_CONF" ]]; then
        input_arg=("--input-conf=$INPUT_CONF")
    fi

    # Launch mpv with GPU VA-API hardware acceleration & optimal low-latency flags
    local err_tmp
    err_tmp=$(mktemp /tmp/ps2_startup_err.XXXXXX)

    if ! mpv \
        "$fullscreen_flag" \
        $geometry_flag \
        "$ontop_flag" \
        "${input_arg[@]}" \
        --no-terminal \
        --no-osc \
        --no-osd-bar \
        --cursor-autohide=always \
        --vo=gpu \
        --hwdec=auto-safe \
        --profile=fast \
        --force-window=immediate \
        --on-all-workspaces \
        --keep-open=no \
        --title="PS2 XFCE Startup" \
        "$VIDEO_FILE" 2>"$err_tmp" >/dev/null; then
        local ret=$?
        if [[ -s "$err_tmp" && -t 1 ]]; then
            echo "[!] mpv startup playback failed with exit code $ret:" >&2
            cat "$err_tmp" >&2
        fi
        rm -f "$err_tmp"
        exit "$ret"
    fi
    rm -f "$err_tmp"
}

play_web() {
    if command -v chromium >/dev/null 2>&1; then
        exec chromium \
            --app="file://${HTML_INDEX}" \
            --kiosk \
            --no-first-run \
            --disable-default-apps \
            >/dev/null 2>&1
    else
        xdg-open "file://${HTML_INDEX}" >/dev/null 2>&1
    fi
}

SYSTEM_SHARE="/usr/local/share/ps2-startup"
THEME_SRC="$BASE_DIR/sddm-theme"
THEME_DST="/usr/share/sddm/themes/ps2-xfce"
SDDM_CONF="/etc/sddm.conf.d/10-ps2-xfce.conf"
XSETUP="/usr/share/sddm/scripts/Xsetup"

install_system_boot() {
    echo "[*] Installing PS2 boot animation (SDDM Xsetup, plays once per boot)..."
    [[ -f "$VIDEO_FILE" ]] || rebuild_video

    sudo install -d -m 755 "$SYSTEM_SHARE"
    sudo install -m 644 "$VIDEO_FILE" "$SYSTEM_SHARE/ps2_startup.mp4"
    sudo install -m 644 "$BASE_DIR/system/boot-input.conf" "$SYSTEM_SHARE/input.conf"
    sudo install -m 644 "$BASE_DIR/system/eof-handoff.lua" "$SYSTEM_SHARE/eof-handoff.lua"
    sudo install -m 755 "$BASE_DIR/system/ps2-system-boot" /usr/local/bin/ps2-system-boot

    if ! grep -q "ps2-system-boot" "$XSETUP" 2>/dev/null; then
        printf '\n# PlayStation 2 System Startup Boot Animation\nif [ -x /usr/local/bin/ps2-system-boot ]; then\n    /usr/local/bin/ps2-system-boot || true\nfi\n' \
            | sudo tee -a "$XSETUP" >/dev/null
    fi
    sudo chmod +x "$XSETUP"
    echo "[✓] Boot animation installed."
}

remove_system_boot() {
    if grep -q "ps2-system-boot" "$XSETUP" 2>/dev/null; then
        sudo sed -i '/# PlayStation 2 System Startup Boot Animation/,+3d' "$XSETUP"
        echo "[✓] Removed PS2 hook from $XSETUP"
    fi
    sudo rm -f /usr/local/bin/ps2-system-boot
    sudo rm -rf "$SYSTEM_SHARE"
    echo "[✓] System startup boot animation disabled."
}

install_greeter() {
    echo "[*] Installing PS2 XFCE login screen (SDDM theme)..."
    [[ -f "$THEME_SRC/background.png" ]] || rebuild_video
    sudo install -d -m 755 "$THEME_DST"
    sudo install -m 644 "$THEME_SRC"/{Main.qml,metadata.desktop,theme.conf,background.png} "$THEME_DST/"
    sudo install -d -m 755 /etc/sddm.conf.d
    printf '[Theme]\nCurrent=ps2-xfce\n\n[Users]\nRememberLastUser=true\nRememberLastSession=true\n' \
        | sudo tee "$SDDM_CONF" >/dev/null
    echo "[✓] SDDM now uses the ps2-xfce theme ($SDDM_CONF)."
}

remove_greeter() {
    sudo rm -f "$SDDM_CONF"
    sudo rm -rf "$THEME_DST"
    echo "[✓] Restored the default SDDM theme."
}

install_boot_sequence() {
    install_system_boot
    install_greeter
    # The animation now plays before login; don't replay it inside the session.
    [[ -f "$AUTOSTART_FILE" ]] && remove_autostart
    echo "[✓] Boot sequence: PS2 animation -> PS2 XFCE login (SDDM) -> desktop"
}

remove_boot_sequence() {
    remove_greeter
    remove_system_boot
}

install_autostart() {
    mkdir -p "$(dirname "$AUTOSTART_FILE")"
    cat > "$AUTOSTART_FILE" << EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=PlayStation 2 XFCE Startup
Comment=Iconic PlayStation 2 inspired animated boot sequence for XFCE 4.20
Exec=$HOME/.local/bin/ps2-startup --play
Terminal=false
StartupNotify=false
OnlyShowIn=XFCE;
X-XFCE-Autostart-Priority=1
X-XFCE-Autostart-enabled=true
EOF
    chmod +x "$AUTOSTART_FILE"
    echo "[✓] Successfully installed XFCE autostart service: $AUTOSTART_FILE"
    echo "[✓] PS2 animation will now play automatically upon every login!"
}

remove_autostart() {
    if [[ -f "$AUTOSTART_FILE" ]]; then
        rm -f "$AUTOSTART_FILE"
        echo "[✓] Successfully removed XFCE autostart: $AUTOSTART_FILE"
    else
        echo "[!] Autostart entry was not installed."
    fi
}

show_status() {
    echo "======================================================================"
    echo "  PS2 XFCE 4.20 Startup Status Report"
    echo "======================================================================"
    local xsetup="/usr/share/sddm/scripts/Xsetup"
    if [[ -x /usr/local/bin/ps2-system-boot ]] && grep -q "ps2-system-boot" "$xsetup" 2>/dev/null; then
        echo -e "  System Boot Splash: \033[1;32mACTIVE\033[0m (Plays on machine startup via SDDM Xsetup)"
    else
        echo -e "  System Boot Splash: \033[1;33mNOT INSTALLED\033[0m (Run --install-system-boot to enable)"
    fi

    if [[ -f "$SDDM_CONF" && -f "$THEME_DST/Main.qml" ]]; then
        echo -e "  Login Screen:       \033[1;32mACTIVE\033[0m (SDDM theme ps2-xfce)"
    else
        echo -e "  Login Screen:       \033[1;33mNOT INSTALLED\033[0m (Run --install-boot-sequence)"
    fi

    if [[ -f "$AUTOSTART_FILE" ]]; then
        echo -e "  User Autostart:     \033[1;32mACTIVE\033[0m ($AUTOSTART_FILE)"
    else
        echo -e "  User Autostart:     \033[1;33mNOT INSTALLED\033[0m (Run --install-autostart to enable)"
    fi

    if [[ -f "$VIDEO_FILE" ]]; then
        local size
        size=$(du -h "$VIDEO_FILE" | cut -f1)
        echo -e "  Master Video:       \033[1;32mREADY\033[0m ($VIDEO_FILE, $size)"
        ffprobe -v error -select_streams v:0 -show_entries stream=width,height,r_frame_rate,codec_name -of csv=p=0 "$VIDEO_FILE" | awk -F',' '{printf "  Resolution:         %sx%s @ %s (%s)\n", $2, $3, $4, $1}'
    else
        echo -e "  Master Video:       \033[1;31mMISSING\033[0m (Run --rebuild to generate)"
    fi
    echo "======================================================================"
}

rebuild_video() {
    echo "[*] Rebuilding PS2 XFCE startup video via multi-core parallel engine..."
    uv run --with pycairo,numpy python3 "$BASE_DIR/render_ps2_video.py" --audio
}

# Command line parsing
ACTION="play"
case "${1:-}" in
    --play)
        ACTION="play"
        ;;
    --window)
        ACTION="window"
        ;;
    --web)
        ACTION="web"
        ;;
    --install-system-boot)
        ACTION="install_system_boot"
        ;;
    --remove-system-boot)
        ACTION="remove_system_boot"
        ;;
    --install-boot-sequence|--remove-boot-sequence|--install-greeter|--remove-greeter)
        ACTION="${1#--}"; ACTION="${ACTION//-/_}"
        ;;
    --install-autostart)
        ACTION="install_autostart"
        ;;
    --remove-autostart)
        ACTION="remove_autostart"
        ;;
    --status)
        ACTION="status"
        ;;
    --rebuild)
        ACTION="rebuild"
        ;;
    -h|--help)
        show_help
        exit 0
        ;;
    "")
        ACTION="play"
        ;;
    *)
        echo "[!] Unknown option: $1"
        show_help
        exit 1
        ;;
esac

case "$ACTION" in
    play)
        play_video
        ;;
    window)
        play_video --window
        ;;
    web)
        play_web
        ;;
    install_system_boot)
        install_system_boot
        ;;
    remove_system_boot)
        remove_system_boot
        ;;
    install_boot_sequence|remove_boot_sequence|install_greeter|remove_greeter)
        "$ACTION"
        ;;
    install_autostart)
        install_autostart
        ;;
    remove_autostart)
        remove_autostart
        ;;
    status)
        show_status
        ;;
    rebuild)
        rebuild_video
        ;;
esac
