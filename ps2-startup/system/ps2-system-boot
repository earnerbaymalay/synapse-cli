#!/usr/bin/env bash
# ps2-system-boot -- PS2 boot animation, run by SDDM's Xsetup before the greeter.
# Plays once per boot, then leaves its final frame on screen; the ps2-xfce SDDM
# theme starts on the identical image, so the animation becomes the login screen.
set -uo pipefail

SHARE=/usr/local/share/ps2-startup
VIDEO=$SHARE/ps2_startup.mp4
STATE=/run/ps2-startup
EOF_FLAG=$STATE/eof

[[ -f $VIDEO ]] && command -v mpv >/dev/null || exit 0
mkdir -p "$STATE" && chmod 700 "$STATE"
if [[ "${1:-}" != "--force" && -e $STATE/played ]]; then
    exit 0
fi
exec 201>"$STATE/lock"
flock -n 201 || exit 0
touch "$STATE/played"
rm -f "$EOF_FLAG"
export DISPLAY="${DISPLAY:-:0}"

# Runs as root on a pre-login screen: no user config, no auto-loaded or builtin
# scripts (mpv's console can execute commands), no default key bindings.
setsid mpv \
    --no-config --load-scripts=no \
    --script="$SHARE/eof-handoff.lua" --script-opts="ps2handoff-flag=$EOF_FLAG" \
    --osc=no --load-console=no --load-stats-overlay=no --load-select=no \
    --load-commands=no --load-context-menu=no --load-positioning=no \
    --load-auto-profiles=no --ytdl=no \
    --no-input-default-bindings --input-conf="$SHARE/input.conf" --no-input-terminal \
    --fs --keep-open=always --force-window=immediate --profile=fast \
    --no-osd-bar --osd-level=0 --cursor-autohide=always \
    --vo=gpu --hwdec=auto-safe --video-sync=display-resample \
    --ao=alsa,pipewire,pulse \
    --title="PS2 System Boot" \
    "$VIDEO" </dev/null >/dev/null 2>&1 &
pid=$!

# Return to SDDM as soon as the last frame is up (or mpv died); poll at 20ms, cap at 20 s.
for _ in $(seq 1000); do
    [[ -e $EOF_FLAG ]] && break
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.02
done

# The greeter maps above the frozen frame; retire mpv once it is covered.
setsid bash -c "sleep 8; kill $pid 2>/dev/null" </dev/null >/dev/null 2>&1 &
exit 0
