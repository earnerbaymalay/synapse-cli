#!/usr/bin/env bash
# agy-menu - GUI Searchable Command Widget using Rofi & Catppuccin theme
set -euo pipefail

declare -A CMD_MAP=(
    ["[AI] agy — Antigravity / Gemini 2.5 Agent CLI"]="xfce4-terminal --working-directory='$HOME/Desktop/AI CLI WORK' -e 'agy'"
    ["[AI] claude — Claude Code Agent CLI"]="xfce4-terminal --working-directory='$HOME/Desktop/AI CLI WORK' -e 'claude'"
    ["[AI] oterm — Terminal Chat TUI (Ollama sessions)"]="xfce4-terminal -e 'oterm'"
    ["[AI] ? <prompt> — Instant inline query to Qwen 2.5 Coder"]="COPY:? \"\""
    ["[AI] ask-qwen — Query Qwen 2.5 Coder (code specialist)"]="COPY:ask-qwen \"\""
    ["[AI] ai warm — Preload Qwen 2.5 Coder into RAM"]="bash -c 'source ~/.bashrc && ai warm && notify-send -i dialog-information \"AI CLI\" \"Pre-warmed Qwen 2.5 Coder into RAM\"'"
    ["[AI] ai flush — Stop resident models & free RAM"]="bash -c 'source ~/.bashrc && ai flush && notify-send -i dialog-information \"AI CLI\" \"Flushed resident models from RAM\"'"
    ["[AI] ai status — Show Ollama resident status & memory"]="xfce4-terminal -H -e 'bash -c \"source ~/.bashrc && ai status; echo; read -p \\\"Press enter to close...\\\"\"'"
    ["[AI] ai-notes — Open Obsidian AI Knowledge Base"]="obsidian"
    ["[AI] ai-log — Quick entry into Obsidian Daily Digest"]="COPY:ai-log \"\""
    ["[SEC] cc -w — Live Command Center Telemetry Dashboard"]="xfce4-terminal --title='Command Center Dashboard' -e 'command-center -w'"
    ["[SEC] sec-status — Check MAC Randomization, DoT & Stealth"]="xfce4-terminal -H -e 'bash -c \"source ~/.bashrc && sec-status; echo; read -p \\\"Press enter to close...\\\"\"'"
    ["[SEC] sys-backup — Snapshot configs & themes to ~/Backups"]="xfce4-terminal -H -e 'bash -c \"$HOME/Desktop/AI\\\\ CLI\\\\ WORK/Scripts/backup-system-configs.sh; echo; read -p \\\"Press enter to close...\\\"\"'"
    ["[SEC] sec-audit — Audit listener ports & pre-commit scan"]="xfce4-terminal -H -e 'bash -c \"source ~/.bashrc && sec-audit; echo; read -p \\\"Press enter to close...\\\"\"'"
    ["[SYS] throttled-status — Dell 7490 25W Thermal Override"]="xfce4-terminal -H -e 'systemctl status throttled --no-pager'"
    ["[SYS] ananicy-status — CachyOS Auto-Nice Daemon"]="xfce4-terminal -H -e 'systemctl status ananicy-cpp --no-pager'"
    ["[SYS] oom-status — Nohang Low-Memory Freeze Protector"]="xfce4-terminal -H -e 'systemctl status nohang --no-pager'"
    ["[DEV] lg — Lazygit TUI with Catppuccin Delta pager"]="xfce4-terminal --working-directory='$HOME/Desktop/AI CLI WORK' -e 'lazygit'"
    ["[DEV] venv — Smart Python venv activator (uv)"]="COPY:venv"
    ["[DEV] clip / clippaste — Fast clipboard copy/paste"]="COPY:clip"
    ["[PENTEST] mitm-harvest — Intercept & harvest auth tokens"]="xfce4-terminal --working-directory='$HOME/Desktop/AI CLI WORK' -e 'uv run mitmproxy -s mitmproxy-tools/token_harvester.py'"
    ["[PENTEST] scope-cap — BPF-scoped Wi-Fi packet capture"]="xfce4-terminal --working-directory='$HOME/Desktop/AI CLI WORK' -e '$HOME/Desktop/AI\\\\ CLI\\\\ WORK/pentest-scope/scoped-capture.sh'"
    ["[UI] font-tune — System typography & font rendering tuner"]="xfce4-terminal -e '$HOME/Desktop/AI\\\\ CLI\\\\ WORK/font-tune.sh'"
    ["[UI] set-wallpaper — 4K wallpaper picker & setter"]="xfce4-terminal -e '$HOME/Desktop/AI\\\\ CLI\\\\ WORK/set-wallpaper.sh'"
    ["[UI] xfce-launcher-toggle — Toggle macOS Launchpad (Super Key)"]="/usr/local/bin/xfce-launcher-toggle"
)

# Build sorted menu list
MENU_ITEMS=$(printf "%s\n" "${!CMD_MAP[@]}" | sort)

CHOICE=$(printf "%s" "$MENU_ITEMS" | rofi -dmenu -i -p "Antigravity CLI" -lines 14 -width 65)

if [[ -n "$CHOICE" && -n "${CMD_MAP[$CHOICE]:-}" ]]; then
    ACTION="${CMD_MAP[$CHOICE]}"
    if [[ "$ACTION" == COPY:* ]]; then
        CMD_TO_COPY="${ACTION#COPY:}"
        printf "%s" "$CMD_TO_COPY" | xclip -selection clipboard
        notify-send -i edit-copy "Antigravity CLI" "Copied to clipboard:\n$CMD_TO_COPY"
    else
        eval "$ACTION" &
    fi
fi
