#!/usr/bin/env bash
# screensaver — Subtle 4K / Fluid / Chromatic / Geomorphic / Glitch Screensaver Suite
# Inspo from Omarchy cyber/developer aesthetic
set -euo pipefail

SCREENSAVER_DIR="$HOME/Desktop/AI CLI WORK/Screensavers"
INDEX_FILE="$SCREENSAVER_DIR/index.html"

THEME=""
PREVIEW=false
SCREENSAVER_MODE=true

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/screensaver"
STATE_FILE="$STATE_DIR/theme_rotation.conf"
mkdir -p "$STATE_DIR"

get_current_boot_id() {
    if [[ -r /proc/sys/kernel/random/boot_id ]]; then
        cat /proc/sys/kernel/random/boot_id
    else
        uptime -s 2>/dev/null || date +%Y%m%d
    fi
}

load_rotation_state() {
    SAVED_BOOT_ID=""
    SAVED_THEME="4"
    if [[ -f "$STATE_FILE" ]]; then
        # shellcheck source=/dev/null
        source "$STATE_FILE" 2>/dev/null || true
    fi
}

rotate_startup_theme() {
    load_rotation_state
    local current_boot
    current_boot=$(get_current_boot_id)

    if [[ "$current_boot" != "$SAVED_BOOT_ID" ]]; then
        # New startup session! Alternate between 4 and 5
        if [[ "$SAVED_THEME" == "4" ]]; then
            SAVED_THEME="5"
        else
            SAVED_THEME="4"
        fi
        SAVED_BOOT_ID="$current_boot"
        cat > "$STATE_FILE" << EOF
SAVED_BOOT_ID="$SAVED_BOOT_ID"
SAVED_THEME="$SAVED_THEME"
EOF
    fi
    echo "$SAVED_THEME"
}

force_rotate_theme() {
    load_rotation_state
    local current_boot
    current_boot=$(get_current_boot_id)

    if [[ "$SAVED_THEME" == "4" ]]; then
        SAVED_THEME="5"
    else
        SAVED_THEME="4"
    fi
    SAVED_BOOT_ID="$current_boot"
    cat > "$STATE_FILE" << EOF
SAVED_BOOT_ID="$SAVED_BOOT_ID"
SAVED_THEME="$SAVED_THEME"
EOF
    echo -e "\033[1;32m[✓]\033[0m Rotated screensaver theme to: \033[1;35m#${SAVED_THEME}\033[0m ($(get_theme_name "$SAVED_THEME"))"
}

get_theme_name() {
    case "$1" in
        1) echo "Liquid Chromium (Y2K fluid mercury waves)" ;;
        2) echo "Geomorphic Tesseract (Sacred 4D wireframe hypercube)" ;;
        3) echo "Cyber Glitch (Horizon grid & digital raster tearing)" ;;
        4) echo "Chromatic Aurora (Subtle fluid multi-harmonic spectral ribbons)" ;;
        5) echo "Omarchy ASCII (Monospace kinetic telemetry emblem)" ;;
        *) echo "Theme #$1" ;;
    esac
}

show_status() {
    load_rotation_state
    local current_boot
    current_boot=$(get_current_boot_id)
    local active_theme="$SAVED_THEME"
    if [[ "$current_boot" != "$SAVED_BOOT_ID" ]]; then
        if [[ "$SAVED_THEME" == "4" ]]; then
            active_theme="5"
        else
            active_theme="4"
        fi
    fi

    echo -e "\033[1;38;2;203;166;247m── 🌌 Omni-Screensaver Status & Startup Rotation ──\033[0m"
    echo -e "  Current Boot ID:    \033[2m${current_boot}\033[0m"
    echo -e "  Recorded Boot ID:   \033[2m${SAVED_BOOT_ID:-None}\033[0m"
    echo -e "  Startup Rotation:   \033[1;32mACTIVE\033[0m (Alternating per startup: #4 ⟷ #5)"
    echo -e "  Active Theme:       \033[1;35m#${active_theme}\033[0m - $(get_theme_name "$active_theme")"
    echo -e "  State File:         \033[2m${STATE_FILE}\033[0m"
    echo ""
    list_themes
}

print_help() {
    cat << 'EOF'
Omni-Screensaver // Y2K Cybernetic & Geomorphic Suite
Usage: screensaver [options]

Options:
  -p, --preview        Launch in windowed preview mode (1100x680)
  -t, --theme <1-5>    Start directly with specific theme:
                         1: Liquid Chromium (Y2K fluid mercury waves)
                         2: Geomorphic Tesseract (Sacred 4D wireframe hypercube)
                         3: Cyber Glitch (Horizon grid & digital raster tearing)
                         4: Chromatic Aurora (Subtle fluid spectral ribbons)
                         5: Omarchy ASCII (Monospace kinetic telemetry emblem)
  -r, --rotate         Manually toggle active theme between #4 and #5
  -s, --status         Show startup rotation status and active theme
  -l, --list           List available themes and visual styles
  -h, --help           Show this help message

Startup Rotation:
  By default, screensaver automatically alternates between Theme #4
  (Chromatic Aurora) and Theme #5 (Omarchy ASCII) per system startup.

Controls while running:
  [1-5]                Directly switch theme
  [SPACE]              Cycle to next theme
  [G]                  Trigger glitch pulse
  [H]                  Toggle HUD information badge
  [F]                  Toggle Fullscreen
  [ESC] / [Q]          Exit screensaver
EOF
}

list_themes() {
    echo -e "\033[1;38;2;203;166;247m── 🌌 Omni-Screensaver Theme Catalog (Omarchy Inspo) ──\033[0m"
    echo -e "  \033[1;38;2;243;139;168m1. Liquid Chromium\033[0m      Y2K viscous mercury waves with RGB chromatic dispersion"
    echo -e "  \033[1;38;2;180;190;254m2. Geomorphic Tesseract\033[0m 4D rotating wireframe hypercube with neon depth glow"
    echo -e "  \033[1;38;2;116;199;236m3. Cyber Glitch\033[0m         Retro-futuristic horizon grid with subtle raster tearing"
    echo -e "  \033[1;38;2;148;226;213m4. Chromatic Aurora\033[0m     Minimalist, ultra-subtle fluid nebula ribbons"
    echo -e "  \033[1;38;2;166;227;161m5. Omarchy ASCII\033[0m        Pure monospace kinetic emblem & live system telemetry"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -p|--preview)
            PREVIEW=true
            SCREENSAVER_MODE=false
            shift
            ;;
        -t|--theme)
            THEME="$2"
            shift 2
            ;;
        -r|--rotate)
            force_rotate_theme
            exit 0
            ;;
        -s|--status)
            show_status
            exit 0
            ;;
        --startup-hook)
            rotate_startup_theme >/dev/null
            exit 0
            ;;
        -l|--list)
            list_themes
            exit 0
            ;;
        -h|--help)
            print_help
            exit 0
            ;;
        --window-id*|--root)
            # Accept screensaver runner arguments gracefully
            shift
            ;;
        *)
            echo "Unknown option: $1"
            print_help
            exit 1
            ;;
    esac
done

if [[ -z "$THEME" ]]; then
    THEME=$(rotate_startup_theme)
fi

PARAMS=()
[[ -n "$THEME" ]] && PARAMS+=("theme=${THEME}")
[[ "$SCREENSAVER_MODE" == true ]] && PARAMS+=("screensaver=1")

QUERY_STRING=""
if [ ${#PARAMS[@]} -gt 0 ]; then
    QUERY_STRING="?$(IFS='&'; echo "${PARAMS[*]}")"
fi
TARGET_URL="file://${INDEX_FILE}${QUERY_STRING}"

# Detect browser runtime (Chromium preferred for hardware accelerated WebGL/canvas)
if command -v chromium >/dev/null 2>&1; then
    if [[ "$PREVIEW" == true ]]; then
        exec chromium \
            --app="${TARGET_URL}" \
            --window-size=1100,680 \
            --disable-extensions \
            --no-first-run \
            --disable-default-apps \
            >/dev/null 2>&1
    else
        exec chromium \
            --kiosk \
            --app="${TARGET_URL}" \
            --disable-extensions \
            --no-first-run \
            --disable-default-apps \
            --disable-pinch \
            --overscroll-history-navigation=0 \
            >/dev/null 2>&1
    fi
elif command -v falkon >/dev/null 2>&1; then
    exec falkon "${TARGET_URL}" >/dev/null 2>&1
else
    xdg-open "${TARGET_URL}" >/dev/null 2>&1
fi
