#!/usr/bin/env bash
# screensaver — Subtle 4K / Fluid / Chromatic / Geomorphic / Glitch Screensaver Suite
# Inspo from Omarchy cyber/developer aesthetic
set -euo pipefail

SCREENSAVER_DIR="$HOME/Desktop/AI CLI WORK/Screensavers"
INDEX_FILE="$SCREENSAVER_DIR/index.html"

THEME=""
PREVIEW=false
SCREENSAVER_MODE=true

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/screensaver"
STATE_FILE="$STATE_DIR/theme_rotation.conf"
mkdir -p "$STATE_DIR"

load_rotation_state() {
    SAVED_THEME="4"
    LAST_ACTIVATED=""
    if [[ -f "$STATE_FILE" ]]; then
        # shellcheck source=/dev/null
        source "$STATE_FILE" 2>/dev/null || true
    fi
    if [[ "$SAVED_THEME" != "4" && "$SAVED_THEME" != "5" ]]; then
        SAVED_THEME="4"
    fi
}

get_next_theme() {
    load_rotation_state
    if [[ "$SAVED_THEME" == "4" ]]; then
        echo "5"
    else
        echo "4"
    fi
}

advance_theme() {
    local next_theme
    next_theme=$(get_next_theme)
    local tmp_file="${STATE_FILE}.tmp.$$"
    cat > "$tmp_file" << EOF
SAVED_THEME="$next_theme"
LAST_ACTIVATED="$(date +%Y-%m-%dT%H:%M:%S%z)"
EOF
    mv -f "$tmp_file" "$STATE_FILE"
    echo "$next_theme"
}

force_rotate_theme() {
    local next_theme
    next_theme=$(advance_theme)
    echo -e "\033[1;32m[✓]\033[0m Rotated screensaver theme to: \033[1;35m#${next_theme}\033[0m ($(get_theme_name "$next_theme"))"
}

get_theme_name() {
    case "$1" in
        1) echo "Liquid Chromium (Y2K fluid mercury waves)" ;;
        2) echo "Geomorphic Tesseract (Sacred 4D wireframe hypercube)" ;;
        3) echo "Cyber Glitch (Horizon grid & digital raster tearing)" ;;
        4) echo "Chromatic Aurora (Subtle fluid multi-harmonic spectral ribbons)" ;;
        5) echo "Omarchy ASCII (Monospace kinetic telemetry emblem)" ;;
        *) echo "Theme #$1" ;;
    esac
}

show_status() {
    load_rotation_state
    local next_theme
    next_theme=$(get_next_theme)

    echo -e "\033[1;38;2;203;166;247m── 🌌 Omni-Screensaver Status & Swap Rotation ──\033[0m"
    echo -e "  Last Activated Theme: \033[1;35m#${SAVED_THEME}\033[0m - $(get_theme_name "$SAVED_THEME")"
    echo -e "  Next Launch Theme:    \033[1;32m#${next_theme}\033[0m - $(get_theme_name "$next_theme")"
    echo -e "  Swap Mode:            \033[1;32mACTIVE\033[0m (Alternating every invocation: #4 ⟷ #5)"
    echo -e "  State File:           \033[2m${STATE_FILE}\033[0m"
    if [[ -n "${LAST_ACTIVATED:-}" ]]; then
        echo -e "  Last Activated At:    \033[2m${LAST_ACTIVATED}\033[0m"
    fi
    echo ""
    list_themes
}

print_help() {
    cat << 'EOF'
Omni-Screensaver // Y2K Cybernetic & Geomorphic Suite
Usage: screensaver [options]

Options:
  -p, --preview        Launch in windowed preview mode (1100x680)
  -t, --theme <1-5>    Start directly with specific theme:
                         1: Liquid Chromium (Y2K fluid mercury waves)
                         2: Geomorphic Tesseract (Sacred 4D wireframe hypercube)
                         3: Cyber Glitch (Horizon grid & digital raster tearing)
                         4: Chromatic Aurora (Subtle fluid spectral ribbons)
                         5: Omarchy ASCII (Monospace kinetic telemetry emblem)
  -r, --rotate         Manually toggle active theme between #4 and #5
  -s, --status         Show swap rotation status and active theme
  -l, --list           List available themes and visual styles
  -h, --help           Show this help message

Swap Rotation:
  By default, screensaver automatically alternates between Theme #4
  (Chromatic Aurora) and Theme #5 (Omarchy ASCII) every single time
  it is invoked / launched.

Controls while running:
  [1-5]                Directly switch theme
  [SPACE]              Cycle to next theme
  [G]                  Trigger glitch pulse
  [H]                  Toggle HUD information badge
  [F]                  Toggle Fullscreen
  [ESC] / [Q]          Exit screensaver
EOF
}

list_themes() {
    echo -e "\033[1;38;2;203;166;247m── 🌌 Omni-Screensaver Theme Catalog (Omarchy Inspo) ──\033[0m"
    echo -e "  \033[1;38;2;243;139;168m1. Liquid Chromium\033[0m      Y2K viscous mercury waves with RGB chromatic dispersion"
    echo -e "  \033[1;38;2;180;190;254m2. Geomorphic Tesseract\033[0m 4D rotating wireframe hypercube with neon depth glow"
    echo -e "  \033[1;38;2;116;199;236m3. Cyber Glitch\033[0m         Retro-futuristic horizon grid with subtle raster tearing"
    echo -e "  \033[1;38;2;148;226;213m4. Chromatic Aurora\033[0m     Minimalist, ultra-subtle fluid nebula ribbons"
    echo -e "  \033[1;38;2;166;227;161m5. Omarchy ASCII\033[0m        Pure monospace kinetic emblem & live system telemetry"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -p|--preview)
            PREVIEW=true
            SCREENSAVER_MODE=false
            shift
            ;;
        -t|--theme)
            if [[ $# -ge 2 && ! "$2" =~ ^- ]]; then
                THEME="$2"
                shift 2
            else
                echo "Error: --theme requires an argument (1-5)" >&2
                exit 1
            fi
            ;;
        -t=*|--theme=*)
            THEME="${1#*=}"
            shift
            ;;
        -r|--rotate)
            force_rotate_theme
            exit 0
            ;;
        -s|--status)
            show_status
            exit 0
            ;;
        --startup-hook)
            advance_theme >/dev/null
            exit 0
            ;;
        -l|--list)
            list_themes
            exit 0
            ;;
        -h|--help)
            print_help
            exit 0
            ;;
        --window-id=*|-window-id=*)
            shift
            ;;
        --window-id|-window-id)
            if [[ $# -ge 2 && ! "$2" =~ ^- ]]; then
                shift 2
            else
                shift
            fi
            ;;
        --root|-root)
            shift
            ;;
        --monitor=*|-monitor=*)
            shift
            ;;
        --monitor|-monitor)
            if [[ $# -ge 2 && ! "$2" =~ ^- ]]; then
                shift 2
            else
                shift
            fi
            ;;
        --width=*|--height=*|-width=*|-height=*)
            shift
            ;;
        --width|--height|-width|-height)
            if [[ $# -ge 2 && ! "$2" =~ ^- ]]; then
                shift 2
            else
                shift
            fi
            ;;
        *)
            # Gracefully ignore unknown screensaver flags passed by display managers/runners
            if [[ "$1" =~ ^- ]]; then
                shift
            else
                echo "Unknown option: $1"
                print_help
                exit 1
            fi
            ;;
    esac
done

if [[ -z "$THEME" ]]; then
    THEME=$(advance_theme)
fi

PARAMS=()
[[ -n "$THEME" ]] && PARAMS+=("theme=${THEME}")
[[ "$SCREENSAVER_MODE" == true ]] && PARAMS+=("screensaver=1")

QUERY_STRING=""
if [ ${#PARAMS[@]} -gt 0 ]; then
    QUERY_STRING="?$(IFS='&'; echo "${PARAMS[*]}")"
fi
TARGET_URL="file://${INDEX_FILE}${QUERY_STRING}"

# Detect browser runtime (Chromium preferred for hardware accelerated WebGL/canvas)
if command -v chromium >/dev/null 2>&1; then
    CHROMIUM_USER_DIR="$STATE_DIR/chromium-profile"
    mkdir -p "$CHROMIUM_USER_DIR"

    # Clean up stale singleton lock if no screensaver chromium process is active
    if ! pgrep -f "chromium.*${CHROMIUM_USER_DIR}" >/dev/null 2>&1; then
        rm -f "${CHROMIUM_USER_DIR}/Singleton"* 2>/dev/null || true
    fi

    CHROMIUM_FLAGS=(
        --user-data-dir="$CHROMIUM_USER_DIR"
        --no-first-run
        --no-default-browser-check
        --disable-session-crashed-bubble
        --disable-infobars
        --noerrdialogs
        --disable-extensions
        --disable-default-apps
        --disable-pinch
        --overscroll-history-navigation=0
        --check-for-update-interval=31536000
    )

    if [[ "$PREVIEW" == true ]]; then
        exec chromium \
            "${CHROMIUM_FLAGS[@]}" \
            --app="${TARGET_URL}" \
            --window-size=1100,680 \
            >/dev/null 2>&1
    else
        exec chromium \
            "${CHROMIUM_FLAGS[@]}" \
            --kiosk \
            --app="${TARGET_URL}" \
            >/dev/null 2>&1
    fi
elif command -v falkon >/dev/null 2>&1; then
    exec falkon "${TARGET_URL}" >/dev/null 2>&1
else
    xdg-open "${TARGET_URL}" >/dev/null 2>&1
fi
