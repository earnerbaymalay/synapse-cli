#!/usr/bin/env bash
# Input pane: every line typed here is timestamped into inbox.md for Claude to read.
INBOX="${XDG_STATE_HOME:-$HOME/.local/state}/claude-console/inbox.md"
touch "$INBOX"
printf "\033[1;38;2;203;166;247m✎ Type a message for Claude and press Enter (Ctrl-C to close)\033[0m\n"
while IFS= read -r -e -p "› " line; do
    [[ -z "$line" ]] && continue
    printf -- "- %s %s\n" "$(date '+%F %H:%M')" "$line" >> "$INBOX"
    printf "\033[38;2;166;227;161m  ✔ sent\033[0m\n"
done
