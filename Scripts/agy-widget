#!/usr/bin/env python3
"""
agy-widget - Antigravity CLI & System Command Widget
Displays live system security/LLM status badges and categorized CLI command references.
"""

import sys
import os
import json
import shutil
import urllib.request
import subprocess
import argparse
import re

try:
    import wcwidth
    def vis_len(text: str) -> int:
        clean = re.sub(r'\x1b\[[0-9;]*[a-zA-Z]', '', text)
        w = wcwidth.wcswidth(clean)
        return w if w >= 0 else len(clean)
except ImportError:
    import unicodedata
    def vis_len(text: str) -> int:
        clean = re.sub(r'\x1b\[[0-9;]*[a-zA-Z]', '', text)
        total = 0
        for c in clean:
            if c in ('\u200d', '\ufe0f', '\ufe0e'):
                continue
            eaw = unicodedata.east_asian_width(c)
            code = ord(c)
            if eaw in ('W', 'F') or (0x1F300 <= code <= 0x1FAFF) or (0x2600 <= code <= 0x27BF):
                total += 2
            else:
                total += 1
        return total

