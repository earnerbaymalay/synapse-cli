def get_telemetry():
    # 1. MAC status
    try:
        with open("/sys/class/net/wlan0/address") as f:
            mac = f.read().strip()
        is_rand = (mac.lower() != "b4:69:21:fa:71:d4")
        mac_badge = f"{GREEN}🔒 {mac[:8]}.. (Rand){RESET}" if is_rand else f"{RED}⚠️ {mac} (HW Leaked!){RESET}"
    except Exception:
        mac_badge = f"{DIM}🔒 wlan0 (N/A){RESET}"

    # 2. DNS-over-TLS
    try:
        res = subprocess.run(["resolvectl", "status", "wlan0"], capture_output=True, text=True, timeout=0.15)
        if "+DNSOverTLS" in res.stdout and "9.9.9.9" in res.stdout:
            dot_badge = f"{GREEN}🛡️ Quad9 DoT:853{RESET}"
        else:
            dot_badge = f"{YELLOW}🛡️ Plain DNS{RESET}"
    except Exception:
        dot_badge = f"{DIM}🛡️ DoT (N/A){RESET}"

    # 3. ICMP Stealth
    try:
        with open("/proc/sys/net/ipv4/icmp_echo_ignore_all") as f:
            icmp = f.read().strip()
        stealth_badge = f"{GREEN}🔥 Drop Stealth{RESET}" if icmp == "1" else f"{YELLOW}🔥 Pingable{RESET}"
    except Exception:
        stealth_badge = f"{DIM}🔥 Firewall{RESET}"

    # 4. Throttled CPU
    try:
        res = subprocess.run(["systemctl", "is-active", "throttled"], capture_output=True, text=True, timeout=0.1)
        throttled_badge = f"{SAPPHIRE}⚡ 25W Boost{RESET}" if "active" in res.stdout else f"{DIM}⚡ CPU Standard{RESET}"
    except Exception:
        throttled_badge = f"{DIM}⚡ CPU{RESET}"

    # 5. Ollama Status
    try:
        req = urllib.request.urlopen("http://127.0.0.1:11434/api/ps", timeout=0.12)
        data = json.loads(req.read().decode())
        models = [m.get("name", "").split(":")[0] for m in data.get("models", [])]
        if models:
            ollama_badge = f"{MAUVE}🧠 {models[0]}{RESET}"
        else:
            ollama_badge = f"{YELLOW}🧠 Standby{RESET}"
    except Exception:
        ollama_badge = f"{RED}🧠 Off{RESET}"

    return [mac_badge, dot_badge, stealth_badge, throttled_badge, ollama_badge]


def print_banner():
    badges = get_telemetry()
    sep = f" {DIM}│{RESET} "
    title = "🤖 AI CLI Workstation & Antigravity Suite"
    
    # Check terminal width (default fallback to 100 cols for standard Kitty)
    term_cols = shutil.get_terminal_size((100, 24)).columns
    
    single_line_badges = sep.join(badges)
    single_line_total_width = vis_len(single_line_badges) + 4
    
    if term_cols >= single_line_total_width:
        badge_rows = [single_line_badges]
        agents = f"{BOLD}{SAPPHIRE}Agents:{RESET} {MAUVE}agy{RESET} · {BLUE}claude{RESET} · {TEAL}oterm{RESET}  {DIM}│{RESET} {BOLD}{SAPPHIRE}Query:{RESET} {YELLOW}? \"prompt\"{RESET} · {YELLOW}ask-qwen{RESET} · {YELLOW}ai{RESET}"
        tools = f"{BOLD}{SAPPHIRE}Tools:{RESET}  {GREEN}lab{RESET} (audit/lines) · {GREEN}cc{RESET} (dash) · {PEACH}lg{RESET} · {PEACH}venv{RESET} · {MAUVE}agy-palette{RESET} (Rofi)"
        footer = f"Type {BOLD}{MAUVE}agy-palette{RESET}{SUBTEXT} for GUI palette or {BOLD}{MAUVE}ai help{RESET}{SUBTEXT} for command cheat-sheet"
    else:
        badge_rows = [
            sep.join(badges[:3]),
            sep.join(badges[3:])
        ]
        agents = f"{BOLD}{SAPPHIRE}Agents:{RESET} {MAUVE}agy{RESET} · {BLUE}claude{RESET} · {TEAL}oterm{RESET}  {DIM}│{RESET} {BOLD}{SAPPHIRE}Query:{RESET} {YELLOW}? \"prompt\"{RESET} · {YELLOW}ask-qwen{RESET} · {YELLOW}ai{RESET}"
        tools = f"{BOLD}{SAPPHIRE}Tools:{RESET}  {GREEN}lab{RESET} · {GREEN}cc{RESET} · {PEACH}lg{RESET} · {PEACH}venv{RESET} · {MAUVE}agy-palette{RESET} (Rofi)"
        footer = f"Type {BOLD}{MAUVE}agy-palette{RESET}{SUBTEXT} for GUI or {BOLD}{MAUVE}ai help{RESET}{SUBTEXT} for command reference"

    content_candidates = badge_rows + [agents, tools]
    content_max = max(vis_len(c) for c in content_candidates)
    
    # Calculate uniform inner width
    inner_width = max(content_max, vis_len(title) + 4, vis_len(footer) + 4)
    if term_cols > 10:
        inner_width = min(inner_width, term_cols - 4)

    def pad_line(content: str) -> str:
        v = vis_len(content)
        pad = max(0, inner_width - v)
        return f"{MAUVE}│{RESET} {content}{' ' * pad} {MAUVE}│{RESET}"

    top_dashes = max(1, inner_width - vis_len(title) - 1)
    bot_dashes = max(1, inner_width - vis_len(footer) - 1)

    print(f"{MAUVE}╭─ {RESET}{BOLD}{title}{RESET} {MAUVE}{'─' * top_dashes}╮{RESET}")
    for r in badge_rows:
        print(pad_line(r))
    print(f"{MAUVE}├{'─' * (inner_width + 2)}┤{RESET}")
    print(pad_line(agents))
    print(pad_line(tools))
    print(f"{MAUVE}╰─ {SUBTEXT}{footer}{RESET} {MAUVE}{'─' * bot_dashes}╯{RESET}")


def print_full():
    badges = get_telemetry()
    sep = f" {DIM}│{RESET} "
    badge_str = sep.join(badges)
    term_width = shutil.get_terminal_size((96, 24)).columns
    term_width = max(term_width, 92)
    line_inner = term_width - 2

    header = "🌌 ANTIGRAVITY COMMAND PALETTE & SYSTEM REFERENCE"
    header_vlen = vis_len(header)
    h_pad_left = max(0, (line_inner - header_vlen) // 2)
    h_pad_right = max(0, line_inner - header_vlen - h_pad_left)

    badge_vlen = vis_len(badge_str)
    b_pad_left = max(0, (line_inner - badge_vlen) // 2)
    b_pad_right = max(0, line_inner - badge_vlen - b_pad_left)

    print(f"{MAUVE}╔{'═' * line_inner}╗{RESET}")
    print(f"{MAUVE}║{RESET}{' ' * h_pad_left}{BOLD}{MAUVE}{header}{RESET}{' ' * h_pad_right}{MAUVE}║{RESET}")
    print(f"{MAUVE}║{RESET}{' ' * b_pad_left}{badge_str}{' ' * b_pad_right}{MAUVE}║{RESET}")
    print(f"{MAUVE}╠{'═' * line_inner}╣{RESET}")

    for cat in COMMAND_CATEGORIES:
        cat_vlen = vis_len(cat['category'])
        cat_pad = max(0, line_inner - cat_vlen - 2)
        print(f"{MAUVE}║{RESET}  {BOLD}{cat['color']}{cat['category']}{RESET}{' ' * cat_pad}{MAUVE}║{RESET}")
        for cmd, desc in cat["items"]:
            cmd_fmt = f"{BOLD}{SAPPHIRE}{cmd:<24}{RESET}"
            desc_fmt = f"{TEXT}{desc}{RESET}"
            visible_len = vis_len(f"    {cmd:<24} {desc}")
            padding = max(0, line_inner - visible_len)
            print(f"{MAUVE}║{RESET}    {cmd_fmt} {desc_fmt}{' ' * padding}{MAUVE}║{RESET}")
        print(f"{MAUVE}║{' ' * line_inner}║{RESET}")

    footer_hint = "Run 'command-center -w' for live metrics | 'agy-palette' for GUI picker"
    f_vlen = vis_len(footer_hint)
    f_pad_left = max(0, (line_inner - f_vlen) // 2)
    f_pad_right = max(0, line_inner - f_vlen - f_pad_left)
    print(f"{MAUVE}╠{'═' * line_inner}╣{RESET}")
    print(f"{MAUVE}║{RESET}{' ' * f_pad_left}{SUBTEXT}{footer_hint}{RESET}{' ' * f_pad_right}{MAUVE}║{RESET}")
    print(f"{MAUVE}╚{'═' * line_inner}╝{RESET}")


def main():
    parser = argparse.ArgumentParser(description="Antigravity Command & Telemetry Widget")
    parser.add_argument("-b", "--banner", action="store_true", help="Print compact shell startup banner")
    parser.add_argument("-f", "--full", action="store_true", help="Print full categorized command reference")
    parser.add_argument("-j", "--json", action="store_true", help="Output telemetry as JSON")
    args = parser.parse_args()

    if args.json:
        # Telemetry JSON
        data = {
            "categories": COMMAND_CATEGORIES
        }
        print(json.dumps(data, indent=2))
    elif args.banner:
        print_banner()
    else:
        print_full()


if __name__ == "__main__":
    main()
