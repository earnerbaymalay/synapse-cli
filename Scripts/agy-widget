#!/usr/bin/env python3
"""
agy-widget - Antigravity CLI & System Command Widget
Displays live system security/LLM status badges and categorized CLI command references.
"""

import sys
import os
import json
import shutil
import urllib.request
import subprocess
import argparse

# Catppuccin Mocha Palette (ANSI 24-bit Truecolor)
MAUVE   = "\033[38;2;203;166;247m"
LAVENDER= "\033[38;2;180;190;254m"
SAPPHIRE= "\033[38;2;116;199;236m"
BLUE    = "\033[38;2;137;180;250m"
TEAL    = "\033[38;2;148;226;213m"
GREEN   = "\033[38;2;166;227;161m"
PEACH   = "\033[38;2;250;179;135m"
YELLOW  = "\033[38;2;249;226;175m"
RED     = "\033[38;2;243;139;168m"
TEXT    = "\033[38;2;205;214;244m"
SUBTEXT = "\033[38;2;166;173;200m"
DIM     = "\033[38;2;108;112;134m"
BOLD    = "\033[1m"
RESET   = "\033[0m"

COMMAND_CATEGORIES = [
